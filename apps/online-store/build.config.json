{
  "appCode": "shopana-online-store",
  "entryPoint": "src/index.ts",
  "outFile": "dist/index.js",
  "migrations": {
    "path": "dist/migrations",
    "type": "node-pg-migrate",
    "schema": "app_shopana_online_store",
    "table": "pgmigrations"
  },
  "assets": [
    {
      "include": "migrations/**/*",
      "outDir": "dist/migrations"
    }
  ]
}
