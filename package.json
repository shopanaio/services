{
  "name": "@shopana/services",
  "version": "0.0.3",
  "private": true,
  "description": "Moleculer-based services for the portal",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/shopana/*",
    "services/*",
    "apps/*",
    "infra/federation",
    "workflows"
  ],
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "shopana": "tsx packages/cli/src/cli.ts",
    "dev": "yarn shopana dev",
    "build": "yarn shopana build",
    "lint": "yarn format:check && oxlint services packages apps infra/federation admin",
    "lint:services": "yarn format:check:services && oxlint services packages apps infra/federation",
    "lint:admin": "yarn format:check:admin && oxlint admin",
    "lint:fix": "oxlint --fix services packages apps infra/federation admin",
    "format": "prettier --config .prettierrc.json --ignore-unknown --write services packages apps infra/federation admin",
    "format:services": "prettier --config .prettierrc.json --ignore-unknown --write services packages apps infra/federation",
    "format:admin": "prettier --config .prettierrc.json --ignore-unknown --write admin",
    "format:check": "prettier --config .prettierrc.json --ignore-unknown --check services packages apps infra/federation admin",
    "format:check:services": "prettier --config .prettierrc.json --ignore-unknown --check services packages apps infra/federation",
    "format:check:admin": "prettier --config .prettierrc.json --ignore-unknown --check admin",
    "codegen": "yarn shopana codegen",
    "iam:openapi": "yarn shopana openapi -s iam",
    "e2e:codegen": "yarn shopana e2e codegen",
    "e2e:test": "yarn shopana e2e test",
    "migrate": "yarn shopana migrate",
    "gateway": "yarn shopana gateway",
    "schema:check": "yarn shopana schema build"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.53.1",
    "esbuild": "^0.24.0",
    "esbuild-plugin-file-path-extensions": "^2.1.3",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6"
  },
  "resolutions": {
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.6",
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "@types/node": "^20.14.14",
    "esbuild": "^0.24.2",
    "uuid": "^11.1.0",
    "graphql-request": "^6.1.0",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.20.6",
    "@apollo/subgraph": "^2.12.1"
  }
}
