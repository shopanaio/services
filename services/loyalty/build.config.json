{
  "entryPoint": "src/loyalty.module.ts",
  "migrations": {
    "path": "dist/migrations",
    "type": "node-pg-migrate"
  },
  "graphql": {
    "admin": [
      "src/api/graphql-admin/schema/**/*.graphql",
      "../../packages/shared-references/graphql/**/*.graphql"
    ],
    "storefront": [
      "src/api/graphql-storefront/schema/**/*.graphql",
      "../../packages/storefront-graphql/graphql/foundation.graphql",
      "../../packages/shared-references/graphql/shared-currency.graphql",
      "../../packages/shared-references/graphql/shared-locale.graphql",
      "../../packages/shared-references/graphql/shared-units.graphql"
    ]
  },
  "assets": [
    {
      "include": "src/api/graphql-admin/schema/**/*.graphql",
      "outDir": "dist/schema"
    },
    {
      "include": "src/api/graphql-storefront/schema/**/*.graphql",
      "outDir": "dist/schema/storefront"
    },
    {
      "include": "../../packages/storefront-graphql/graphql/foundation.graphql",
      "outDir": "dist/schema/storefront"
    },
    {
      "include": "../../packages/shared-references/graphql/shared-currency.graphql",
      "outDir": "dist/schema/storefront"
    },
    {
      "include": "../../packages/shared-references/graphql/shared-locale.graphql",
      "outDir": "dist/schema/storefront"
    },
    {
      "include": "../../packages/shared-references/graphql/shared-units.graphql",
      "outDir": "dist/schema/storefront"
    },
    {
      "include": "../../packages/shared-references/graphql/**/*.graphql",
      "outDir": "dist/schema"
    },
    {
      "include": "migrations/**/*",
      "outDir": "dist/migrations"
    }
  ]
}
