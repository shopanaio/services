# Bootstrap Configuration
# All configuration is loaded from config.yml
# Environment variables can be used to override specific settings

# Optional: Override log level (default from config.yml)
# LOG_LEVEL=debug

# Optional: Override metrics port (default: 3030)
# METRICS_PORT=3030

# Optional: Override environment
# NODE_ENV=development

# Required for IAM application auth in development.
# Generate a private 32-byte key; never commit the real value.
# IAM_APPLICATION_AUTH_ACTIVE_KEY_VERSION=1
# IAM_APPLICATION_AUTH_ROOT_KEYS={"1":"<base64-encoded-32-byte-secret>"}

# Required by the SMTP App to encrypt per-connection passwords and API keys.
# Keep the same 32-byte key on every runtime instance and across restarts.
# SMTP_CREDENTIAL_MASTER_KEY=base64:<base64-encoded-32-byte-secret>

# Platform gRPC host
# PLATFORM_GRPC_HOST=platform:50051
